{
  "expo": {
    "name": "Muskill Asaan",
    "slug": "muskill-asaan-mobile",
    "scheme": "muskillasaan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#00875A"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.mushkilasan.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E3F5EE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Muskill Asaan needs camera access so you can take photos for identity setup and job posts.",
          "photosPermission": "Muskill Asaan needs photo library access so you can choose photos for identity setup and job posts."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4eb0731f-628c-4048-862e-706155dff8cb"
      }
    }
  }
}
